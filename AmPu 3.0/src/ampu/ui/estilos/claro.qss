QMainWindow, QWidget#Raiz, QStackedWidget { background:#F3F7FB; color:#162946; }
QWidget { font-size:14px; color:#20334E; }
QFrame#Sidebar { background:#152741; border:0; }
QLabel#Brand { color:#FAFFFF; font-size:24px; font-weight:800; letter-spacing:1px; }
QLabel#BrandSub { color:#9EB7CA; font-size:12px; letter-spacing:1px; }
QLabel#SidebarHeading { color:#7494AE; font-weight:800; font-size:12px; letter-spacing:2px; }
QPushButton#NavButton { background:transparent; border:0; border-radius:10px; color:#BDD0DC; text-align:left; padding:12px 15px; font-size:13px; font-weight:600; }
QPushButton#NavButton:hover { background:#253E59; color:#FFFFFF; }
QPushButton#NavActive { background:#286B7A; border:1px solid #3D9DA0; border-radius:10px; color:#FFFFFF; text-align:left; padding:12px 15px; font-size:13px; font-weight:700; }
QFrame#SidebarBottom { background:#1E3550; border:1px solid #294862; border-radius:12px; }
QLabel#SidebarInfo { color:#ACCAD4; font-size:12px; }
QFrame#Card, QFrame#FormCard, QFrame#ChartCard { background:#FFFFFF; border:1px solid #DDE7F0; border-radius:16px; }
QFrame#KpiCard { background:#FFFFFF; border:1px solid #DDE7F0; border-radius:14px; }
QLabel#Eyebrow { color:#087E73; font-size:12px; font-weight:800; letter-spacing:2px; }
QLabel#H1 { color:#142844; font-size:28px; font-weight:800; }
QLabel#H2 { color:#172E4A; font-size:16px; font-weight:700; }
QLabel#Muted { color:#61778C; font-size:12px; }
QLabel#KpiNumber { color:#18304E; font-size:22px; font-weight:800; }
QLabel#KpiLabel { color:#526A80; font-size:12px; font-weight:700; }
QLabel#Error { color:#B43D3D; font-size:12px; }
QLabel#Note { color:#506A82; font-size:12px; }
QLabel#Success { color:#087E73; font-size:12px; font-weight:600; }
QPushButton#Primary, QToolButton#Primary { background:#087E73; color:#FFFFFF; border:1px solid #087E73; border-radius:9px; padding:10px 17px; font-weight:700; }
QMenu { background:#FFFFFF; border:1px solid #DDE7F0; color:#172E4A; padding:7px; }
QMenu::item { padding:8px 18px; border-radius:5px; }
QMenu::item:selected { background:#DDF2EE; }
QPushButton#Primary:hover, QToolButton#Primary:hover { background:#0B756F; border-color:#0B756F; }
QPushButton#Primary:disabled { background:#A0C9C5; border-color:#A0C9C5; color:#F4F8F9; }
QPushButton#Secondary { background:#F1F7F9; border:1px solid #C9DBE4; border-radius:9px; padding:9px 14px; color:#18525E; font-weight:600; }
QPushButton#Secondary:hover { background:#E2F0F0; border-color:#8BBCBA; }
QPushButton#Quiet { background:transparent; border:0; border-radius:8px; padding:8px; color:#58728A; font-weight:600; }
QPushButton#Quiet:hover { background:#E9F0F5; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit { background:#FAFCFE; border:1px solid #C9D9E7; border-radius:8px; padding:8px; selection-background-color:#25A69A; color:#172E4A; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover { border-color:#87AEBD; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border:2px solid #1C9992; }
QComboBox::drop-down { border:0; width:22px; }
QComboBox QAbstractItemView { background:#FFFFFF; selection-background-color:#D9F4EF; selection-color:#163551; border:1px solid #C9D9E7; }
QCheckBox { spacing:8px; }
QCheckBox::indicator { width:16px; height:16px; }
QTableWidget, QTableView { background:#FFFFFF; alternate-background-color:#F4F8FC; color:#213B55; border:1px solid #E1E9F0; border-radius:8px; gridline-color:#E5EDF4; selection-background-color:#B2E3DC; selection-color:#102838; }
QHeaderView::section { background:#EAF2F6; color:#274960; padding:8px; border:0; border-right:1px solid #DBE7ED; font-size:12px; font-weight:700; }
QScrollArea, QScrollArea > QWidget > QWidget { background:transparent; border:0; }
QScrollBar:vertical { background:transparent; width:10px; } QScrollBar::handle:vertical { background:#B7C9D8; border-radius:5px; min-height:25px; }
QScrollBar:horizontal { background:transparent; height:10px; } QScrollBar::handle:horizontal { background:#B7C9D8; border-radius:5px; min-width:25px; }
QStatusBar { background:#ECF2F7; color:#526A80; border-top:1px solid #DEE8F0; }
QProgressBar { background:#E9F3F3; border:0; border-radius:3px; height:5px; } QProgressBar::chunk { background:#27B9A8; border-radius:3px; }
QSplitter::handle { background:#E5EDF4; }
QToolTip { background:#1B304B; color:#FFFFFF; border:1px solid #38536A; padding:6px; }

/* Foco perceptible con teclado, menús y paneles acoplables. Sin animaciones. */
QPushButton#NavButton:focus, QPushButton#NavActive:focus { border:3px solid #F6C25C; padding:9px 12px; }
QPushButton#Primary:focus, QToolButton#Primary:focus,
QPushButton#Secondary:focus, QPushButton#Quiet:focus {
    border:3px solid #D48000; padding:7px 12px;
}
QTableWidget:focus, QTableView:focus, QListWidget:focus, QTreeView:focus,
QCheckBox:focus, QTabBar::tab:focus { border:2px solid #D48000; }
QTabBar::tab { padding:9px 14px; }
QTabBar::tab:selected { border-bottom:3px solid #087E73; font-weight:700; }
QDockWidget::title { padding:8px; font-weight:700; }
QMenu::item:disabled { color:#7C8793; }
QMenuBar::item:selected, QMenuBar::item:pressed { background:#DDF2EE; color:#162946; }
QSplitter::handle:horizontal { width:6px; }
