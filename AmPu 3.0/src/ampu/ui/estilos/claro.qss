/* AmPu · claro: superficies limpias, tinta oscura y acento accesible. */
QMainWindow, QWidget#Raiz, QStackedWidget { background:#F4F7FB; color:#172B45; }
QWidget { font-size:15px; color:#1D3049; }
QFrame#Sidebar { background:#172A43; border:0; }
QLabel#Brand { color:#FFFFFF; font-size:25px; font-weight:800; letter-spacing:1px; }
QLabel#BrandSub { color:#C0D0DF; font-size:13px; letter-spacing:1px; }
QLabel#SidebarHeading { color:#B4C7D8; font-weight:800; font-size:13px; letter-spacing:1px; }
QPushButton#NavButton { background:transparent; border:1px solid transparent; border-radius:9px; color:#D7E2ED; text-align:left; padding:12px 14px; font-size:14px; font-weight:600; }
QPushButton#NavButton:hover { background:#263E59; color:#FFFFFF; }
QPushButton#NavActive { background:#176A72; border:1px solid #4CB8B0; border-radius:9px; color:#FFFFFF; text-align:left; padding:12px 14px; font-size:14px; font-weight:700; }
QFrame#SidebarBottom { background:#203853; border:1px solid #38526D; border-radius:11px; }
QLabel#SidebarInfo { color:#D0DEE9; font-size:13px; }
QFrame#Card, QFrame#FormCard, QFrame#ChartCard, QFrame#KpiCard { background:#FFFFFF; border:1px solid #D3DDE8; border-radius:13px; }
QLabel#Eyebrow { color:#087568; font-size:13px; font-weight:800; letter-spacing:1px; }
QLabel#H1 { color:#172B45; font-size:30px; font-weight:800; }
QLabel#H2 { color:#1D3552; font-size:18px; font-weight:700; }
QLabel#Muted, QLabel#Note { color:#52657A; font-size:13px; }
QLabel#KpiNumber { color:#172B45; font-size:24px; font-weight:800; }
QLabel#KpiLabel { color:#455B73; font-size:13px; font-weight:700; }
QLabel#Error { color:#A32727; font-size:13px; }
QLabel#Success { color:#08685E; font-size:13px; font-weight:700; }
QPushButton#Primary, QToolButton#Primary { background:#087568; color:#FFFFFF; border:1px solid #087568; border-radius:8px; padding:10px 16px; font-weight:700; }
QPushButton#Primary:hover, QToolButton#Primary:hover { background:#075E55; border-color:#075E55; }
QPushButton#Primary:disabled, QToolButton#Primary:disabled { background:#D2D9E1; border-color:#D2D9E1; color:#405166; }
QPushButton#Secondary { background:#F1F6F8; border:1px solid #B8C9D5; border-radius:8px; padding:9px 13px; color:#174B55; font-weight:650; }
QPushButton#Secondary:hover { background:#E0EFF0; border-color:#6D9FA1; }
QPushButton#Quiet { background:transparent; border:1px solid transparent; border-radius:7px; padding:8px 10px; color:#405B75; font-weight:650; }
QPushButton#Quiet:hover { background:#E6EDF3; color:#172B45; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit { background:#FFFFFF; border:1px solid #AEBECD; border-radius:7px; padding:8px; selection-background-color:#087568; selection-color:#FFFFFF; color:#172B45; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover { border-color:#547B91; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border:2px solid #087568; }
QComboBox::drop-down { border:0; width:25px; }
QComboBox QAbstractItemView, QListWidget, QTreeView { background:#FFFFFF; color:#172B45; selection-background-color:#D9EEEA; selection-color:#163A3E; border:1px solid #AEBECD; }
QCheckBox, QRadioButton { spacing:8px; color:#263B53; }
QCheckBox::indicator, QRadioButton::indicator { width:17px; height:17px; }
QTableWidget, QTableView { background:#FFFFFF; alternate-background-color:#F0F4F8; color:#203750; border:1px solid #C9D5E0; border-radius:7px; gridline-color:#D5DFE8; selection-background-color:#B8DED8; selection-color:#122D32; }
QHeaderView::section { background:#E7EDF3; color:#263F58; padding:9px 8px; border:0; border-right:1px solid #D1DCE6; font-size:13px; font-weight:700; }
QScrollArea, QScrollArea > QWidget > QWidget { background:transparent; border:0; }
QScrollBar:vertical { background:transparent; width:12px; margin:2px; } QScrollBar::handle:vertical { background:#9AABBB; border-radius:5px; min-height:28px; }
QScrollBar:horizontal { background:transparent; height:12px; margin:2px; } QScrollBar::handle:horizontal { background:#9AABBB; border-radius:5px; min-width:28px; }
QStatusBar { background:#E9EFF5; color:#40566D; border-top:1px solid #CCD7E1; }
QProgressBar { background:#DDE7E9; border:0; border-radius:3px; height:6px; } QProgressBar::chunk { background:#087568; border-radius:3px; }
QSplitter::handle { background:#D3DDE7; }
QToolTip { background:#172B45; color:#FFFFFF; border:1px solid #405874; padding:7px; }
QMenu, QMenuBar { background:#FFFFFF; color:#172B45; }
QMenu { border:1px solid #C9D5E0; padding:5px; }
QMenu::item { padding:8px 22px; border-radius:4px; }
QMenu::item:selected, QMenuBar::item:selected, QMenuBar::item:pressed { background:#D9EEEA; color:#163A3E; }
QMenu::item:disabled { color:#5F6E7D; }
QPushButton#NavButton:focus, QPushButton#NavActive:focus { border:3px solid #F4C95D; padding:10px 12px; }
QPushButton#Primary:focus, QToolButton#Primary:focus, QPushButton#Secondary:focus, QPushButton#Quiet:focus { border:3px solid #A55700; padding:7px 11px; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border:2px solid #087568; }
QTableWidget:focus, QTableView:focus, QListWidget:focus, QTreeView:focus, QCheckBox:focus, QRadioButton:focus, QTabBar::tab:focus { border:2px solid #A55700; }
QTabBar::tab { padding:10px 15px; }
QTabBar::tab:selected { border-bottom:3px solid #087568; font-weight:700; color:#172B45; }
QDockWidget::title { padding:9px; font-weight:700; }
QSplitter::handle:horizontal { width:6px; }
