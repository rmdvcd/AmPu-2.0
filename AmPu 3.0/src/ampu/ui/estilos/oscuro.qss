/* AmPu · oscuro: tinta clara, superficies separadas y acentos luminosos. */
QMainWindow, QWidget#Raiz, QStackedWidget { background:#101827; color:#F2F5F9; }
QWidget { font-size:15px; color:#E8EDF4; }
QFrame#Sidebar { background:#0C1421; border:0; }
QLabel#Brand { color:#FFFFFF; font-size:25px; font-weight:800; letter-spacing:1px; }
QLabel#BrandSub { color:#C0CFDE; font-size:13px; letter-spacing:1px; }
QLabel#SidebarHeading { color:#B9C9D8; font-weight:800; font-size:13px; letter-spacing:1px; }
QPushButton#NavButton { background:transparent; border:1px solid transparent; border-radius:9px; color:#D2DCE7; text-align:left; padding:12px 14px; font-size:14px; font-weight:600; }
QPushButton#NavButton:hover { background:#23354A; color:#FFFFFF; }
QPushButton#NavActive { background:#205E66; border:1px solid #54BDB2; border-radius:9px; color:#FFFFFF; text-align:left; padding:12px 14px; font-size:14px; font-weight:700; }
QFrame#SidebarBottom { background:#18273A; border:1px solid #394B60; border-radius:11px; }
QLabel#SidebarInfo { color:#D2DEE9; font-size:13px; }
QFrame#Card, QFrame#FormCard, QFrame#ChartCard, QFrame#KpiCard { background:#19283B; border:1px solid #40516A; border-radius:13px; }
QLabel#Eyebrow { color:#67D8CA; font-size:13px; font-weight:800; letter-spacing:1px; }
QLabel#H1 { color:#F5F7FA; font-size:30px; font-weight:800; }
QLabel#H2 { color:#EDF2F7; font-size:18px; font-weight:700; }
QLabel#Muted, QLabel#Note { color:#C0CCD9; font-size:13px; }
QLabel#KpiNumber { color:#F5F7FA; font-size:24px; font-weight:800; }
QLabel#KpiLabel { color:#C5D0DC; font-size:13px; font-weight:700; }
QLabel#Error { color:#FFAAAA; font-size:13px; }
QLabel#Success { color:#7CE2D1; font-size:13px; font-weight:700; }
QPushButton#Primary, QToolButton#Primary { background:#087568; color:#FFFFFF; border:1px solid #45B4A6; border-radius:8px; padding:10px 16px; font-weight:700; }
QPushButton#Primary:hover, QToolButton#Primary:hover { background:#0A645C; border-color:#7AE1D4; }
QPushButton#Primary:disabled, QToolButton#Primary:disabled { background:#354459; border-color:#53647A; color:#C0CAD6; }
QPushButton#Secondary { background:#23364B; border:1px solid #53677D; border-radius:8px; padding:9px 13px; color:#C5F2EB; font-weight:650; }
QPushButton#Secondary:hover { background:#30485E; border-color:#83B7B6; }
QPushButton#Quiet { background:transparent; border:1px solid transparent; border-radius:7px; padding:8px 10px; color:#C1D0DE; font-weight:650; }
QPushButton#Quiet:hover { background:#26394D; color:#FFFFFF; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit { background:#202F43; border:1px solid #5B6D82; border-radius:7px; padding:8px; selection-background-color:#197D76; selection-color:#FFFFFF; color:#F3F6FA; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover { border-color:#93A9BC; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border:2px solid #72DCCE; }
QComboBox::drop-down { border:0; width:25px; }
QComboBox QAbstractItemView, QListWidget, QTreeView { background:#202F43; color:#F3F6FA; selection-background-color:#315B61; selection-color:#FFFFFF; border:1px solid #5B6D82; }
QCheckBox, QRadioButton { spacing:8px; color:#E6ECF3; }
QCheckBox::indicator, QRadioButton::indicator { width:17px; height:17px; }
QTableWidget, QTableView { background:#19283B; alternate-background-color:#223247; color:#E7EDF4; border:1px solid #465970; border-radius:7px; gridline-color:#3D5066; selection-background-color:#315E64; selection-color:#FFFFFF; }
QHeaderView::section { background:#293D53; color:#F0F4F8; padding:9px 8px; border:0; border-right:1px solid #465970; font-size:13px; font-weight:700; }
QScrollArea, QScrollArea > QWidget > QWidget { background:transparent; border:0; }
QScrollBar:vertical { background:transparent; width:12px; margin:2px; } QScrollBar::handle:vertical { background:#60758B; border-radius:5px; min-height:28px; }
QScrollBar:horizontal { background:transparent; height:12px; margin:2px; } QScrollBar::handle:horizontal { background:#60758B; border-radius:5px; min-width:28px; }
QStatusBar { background:#172437; color:#CED8E3; border-top:1px solid #3B4D63; }
QProgressBar { background:#2B3C50; border:0; border-radius:3px; height:6px; } QProgressBar::chunk { background:#58CDBD; border-radius:3px; }
QSplitter::handle { background:#3B4D63; }
QToolTip { background:#F0F4F7; color:#172B45; border:1px solid #7890A6; padding:7px; }
QMenu, QMenuBar { background:#19283B; color:#F2F5F9; }
QMenu { border:1px solid #52657A; padding:5px; }
QMenu::item { padding:8px 22px; border-radius:4px; }
QMenu::item:selected, QMenuBar::item:selected, QMenuBar::item:pressed { background:#31505D; color:#FFFFFF; }
QMenu::item:disabled { color:#BDCAD8; }
QPushButton#NavButton:focus, QPushButton#NavActive:focus { border:3px solid #F4C95D; padding:10px 12px; }
QPushButton#Primary:focus, QToolButton#Primary:focus, QPushButton#Secondary:focus, QPushButton#Quiet:focus { border:3px solid #F4C95D; padding:7px 11px; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border:2px solid #72DCCE; }
QTableWidget:focus, QTableView:focus, QListWidget:focus, QTreeView:focus, QCheckBox:focus, QRadioButton:focus, QTabBar::tab:focus { border:2px solid #F4C95D; }
QTabBar::tab { padding:10px 15px; }
QTabBar::tab:selected { border-bottom:3px solid #67D8CA; font-weight:700; color:#FFFFFF; }
QDockWidget::title { padding:9px; font-weight:700; }
QSplitter::handle:horizontal { width:6px; }
